{
  "name": "vokter-api",
  "version": "1.0.0",
  "description": "API segura entre la tienda VOKTER y la base MySQL comercio (tabla data_comercio)",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --watch --env-file=.env server.js",
    "probar-conexion": "node --env-file=.env scripts/probar-conexion.js",
    "test": "node --test test/api.test.js test/comercio.test.js",
    "test:conexion": "node --env-file=.env --test test/conexion.test.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "mysql2": "3.11.3"
  }
}
