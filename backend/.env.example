# Copia este archivo como .env y llena los valores. El archivo .env NUNCA se sube a GitHub.

# --- Servidor de la API ---
PORT=3000
# 127.0.0.1 = solo accesible desde tu propio computador
HOST=127.0.0.1
# desarrollo: el código de verificación se muestra en la consola y en la respuesta (no hay correo)
# produccion: el código solo se envía por correo (requiere configurar el envío)
MODO=desarrollo

# Páginas que pueden usar la API (separadas por coma). Live Server de VS Code usa el puerto 5500.
ORIGENES_PERMITIDOS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=comercio
# Usuario de solo lectura creado con sql/01_usuario_api.sql (no uses root)
DB_USER=vokter_api
DB_PASSWORD=pon_aqui_la_clave_del_usuario_vokter_api

# --- Administración ---
# Token para las consultas de administrador (/api/comercio). Mínimo 32 caracteres aleatorios.
# Genéralo con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
